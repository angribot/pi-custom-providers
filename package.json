{
  "name": "pi-custom-providers",
  "version": "0.1.0",
  "description": "pi extension for custom providers, with metadata and pricing that line up",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension",
    "providers",
    "relay",
    "pricing"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/angribot/pi-custom-providers.git"
  },
  "files": [
    "index.ts",
    "src",
    "custom-providers.schema.json",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "test": "node --test \"src/*.test.mjs\"",
    "typecheck": "tsc"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.82.1",
    "@earendil-works/pi-coding-agent": "^0.82.1",
    "typescript": "^7.0.2"
  }
}
